CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=102400
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y


# Use an internal DMA bounce buffer so incomplete RGB frames can be rejected.
# Limit its size to preserve internal heap for AFE and WakeNet.
CONFIG_CAMERA_PSRAM_DMA=n
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=16384

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y
# Builtin TLSF pool in PSRAM (lvgl_psram_pool.h). Keep the base pool small
# enough for 2MB PSRAM boards; 8MB boards add extra pools in lcd_display.cc
# (chunked to LV_MEM_SIZE — TLSF rejects a single add_pool larger than this).
# Variants that set CONFIG_SPIRAM=n are switched back to CLIB malloc in
# scripts/build.py; do not repeat that override on each board.
CONFIG_LV_USE_BUILTIN_MALLOC=y
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_MEM_SIZE_KILOBYTES=1024

# ==== 自定义唤醒词（MultiNet 方案，微信通话移植）====
# 运行时自动切换：assets 含 mn7_cn 多段式模型 → CustomWakeWord（按拼音匹配，任意词免训练）
CONFIG_USE_AFE_WAKE_WORD=n
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_SR_MN_CN_NONE=n
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
# 关闭 wn9 唤醒模型（CustomWakeWord 用不到；对话降噪的 NS/VAD 模型不受影响）
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n
# 拼音格式：不带声调，音节间空格（esp-sr 2.3.0 词表无声调，带声调会被拒、命令表清零）
CONFIG_CUSTOM_WAKE_WORD="ni hao xiao chang"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="你好小畅"
# 灵敏度阈值（%），越小越灵敏；误唤醒多调大至 30~40，不灵敏调小至 15~20
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=25
